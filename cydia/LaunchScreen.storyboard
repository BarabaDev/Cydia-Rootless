                                <rect key="frame" x="28" y="137" width="78" height="78"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="78" id="CYD-icon-width"/>
                                    <constraint firstAttribute="height" constant="78" id="CYD-icon-height"/>
                                </constraints>
                            </imageView>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Welcome to Cydia™" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" translatesAutoresizingMaskIntoConstraints="NO" id="CYD-launch-title">
                                <rect key="frame" x="139" y="141" width="263" height="34"/>
                                <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="28"/>
                                <color key="textColor" systemColor="labelColor"/>
