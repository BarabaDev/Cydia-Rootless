                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Home" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="CYD-launch-navigation-title">
                                <rect key="frame" x="190" y="70" width="50" height="22"/>
                                <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="17"/>
                                <color key="textColor" systemColor="labelColor"/>
